# Banco Postgres (Neon). Na Vercel é preenchido automaticamente ao conectar o Neon em Storage.
DATABASE_URL="postgres://usuario:senha@host/banco?sslmode=require"

# Chave para assinar os cookies de login. Mínimo de 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Código exigido na página /setup para criar o primeiro administrador.
CODIGO_SETUP=""

# (Opcional) Código de convite para os membros se cadastrarem em /registrar.
# Deixe vazio para que só o administrador possa criar contas.
CODIGO_CONVITE=""

# Token do Vercel Blob (upload das capas). Preenchido automaticamente ao criar um Blob Store na Vercel.
# Sem ele, as capas só podem ser informadas por link.
BLOB_READ_WRITE_TOKEN=""
